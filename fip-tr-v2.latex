\textbf{A EXAMPLE CODE}\\
This section contains the full examples discussed in Section 4. These
examples do not use match!, drop or free as they are automatically
inferred by our implementation. We also write val (C x1 ... xn) = x in e
for match x \{ C x1 ... xn -\textgreater{} e \} if the match has just a
single case.

\begin{quote}
\textbf{A.1} \textbf{Red-Black Trees}

import std/num/int32

type color\\
Red\\
Black

type tree\\
Node(color : color, lchild : tree, key : int32, value : bool, rchild :
tree) Leaf

fip fun is-red(\^{}t : tree) : bool\\
match t\\
Node(Red) -\textgreater{} True\\
\_ -\textgreater{} False

type accum\\
Done\\
NodeL(color : color, lchild : accum, key : int32, value : bool, rchild :
tree) NodeR(color : color, lchild : tree, key : int32, value : bool,
rchild : accum)

fip(1) fun ins(t : tree, key : int32, v : bool, z : accum) : exn tree
match t\\
Node(c, l, kx, vx, r)\\
-\textgreater{} if key \textless{} kx then ins(l, key, v, NodeL(c, z,
kx, vx, r)) elif key \textgreater{} kx then ins(r, key, v, NodeR(c, l,
kx, vx, z)) else balance(z, Node(c, l, key, v, r))\\
Leaf -\textgreater{} balance(z, Node(Red, Leaf, key, v, Leaf))

fip fun set-black(t : tree) : tree\\
match t\\
Node(\_, l, k, v, r) -\textgreater{} Node(Black, l, k, v, r)\\
t -\textgreater{} t

fip fun rebuild(z : accum, t : tree) // Turn the zipper into a tree
without rotating match z\\
NodeR(c, l, k, v, z1) -\textgreater{} rebuild(z1, Node(c, l, k, v, t))\\
NodeL(c, z1, k, v, r) -\textgreater{} rebuild(z1, Node(c, t, k, v, r))\\
Done -\textgreater{} t

fip(1) fun insert(t : tree, k : int32, v : bool) :
\textless exn\textgreater{} tree ins(t, k, v, Done)

fip fun balance( z : accum, t : tree ) : exn tree\\
match z\\
NodeR(Red, l1, k1, v1, z1) -\textgreater{} match z1\\
NodeR(\_,l2,k2,v2,z2) -\textgreater{} // black\\
if is-red(l2) then balance(z2, Node(Red, l2.set-black, k2, v2,
Node(Black, l1, k1, v1, t) )) else rebuild(z2, Node(Black,
Node(Red,l2,k2,v2,l1), k1, v1, t))\\
NodeL(\_,z2,k2,v2,r2) -\textgreater{} // black\\
if is-red(r2) then balance(z2, Node(Red, Node(Black,l1,k1,v1,t), k2, v2,
r2.set-black)) else match t\\
Node(\_, l, k, v, r) -\textgreater{}\\
rebuild(z2, Node(Black, Node(Red,l1,k1,v1,l), k, v,
Node(Red,r,k2,v2,r2)))\\
Done -\textgreater{} Node(Black, l1, k1, v1, t)\\
NodeL(Red, z1, k1, v1, r1) -\textgreater{} match z1\\
NodeL(\_,z2,k2,v2,r2) -\textgreater{} // black\\
if is-red(r2) then balance(z2, Node(Red, Node(Black, t, k1, v1, r1), k2,
v2, r2.set-black )) else rebuild(z2, Node(Black, t, k1, v1,
Node(Red,r1,k2,v2,r2)))
\end{quote}

32

Anton Lorenzen, Daan Leijen, and Wouter Swierstra

\begin{quote}
NodeR(\_,l2,k2,v2,z2) -\textgreater{} // black\\
if is-red(l2) then balance(z2, Node(Red, l2.set-black, k2, v2,
Node(Black,t,k1,v1,r1) )) else match t\\
Node(\_, l, k, v, r) -\textgreater{}\\
rebuild(z2, Node(Black, Node(Red,l2,k2,v2,l), k, v,
Node(Red,r,k1,v1,r1)))\\
Done -\textgreater{} Node(Black, t, k1, v1, r1)\\
z -\textgreater{} rebuild(z, t)
\end{quote}

\textbf{A.2} \textbf{Stable Merge Sort}\\
Derived from the merge sort of Haskell's Data.List.sort function.

\begin{quote}
import std/num/int32\\
import std/os/env

alias elem = int32

ref type pad\\
Pad

type unit2\\
Unit2(a : pad, b : pad)

type pair\textless a\textgreater{}\\
Pair(a : a, b : a)

type sublist\textless a\textgreater{}\\
SCons(a : a, cs : sublist\textless a\textgreater)\\
STuple(a : a, b : a)

type partition\textless a\textgreater{}\\
Sublist(c : sublist\textless a\textgreater, z :
partition\textless a\textgreater)\\
Singleton(c : a, z : partition\textless a\textgreater)\\
End

fip fun reverse-go(c : sublist\textless a\textgreater, acc :
sublist\textless a\textgreater, u : unit2) :
sublist\textless a\textgreater{} match c\\
SCons(a, cs) -\textgreater{} reverse-go(cs, SCons(a, acc), u)\\
STuple(a, b) -\textgreater{} SCons(b, SCons(a, acc))

fip fun reverse-sublist(c : sublist\textless a\textgreater) :
sublist\textless a\textgreater{}\\
match c\\
SCons(a, SCons(b, c)) -\textgreater{} reverse-go(c, STuple(b, a),
Unit2(Pad,Pad)) SCons(a, STuple(b, c)) -\textgreater{} SCons(c,
STuple(b, a))\\
STuple(a, b) -\textgreater{} STuple(b, a)

fip fun sequences(xs : list\textless elem\textgreater) : div
partition\textless elem\textgreater{} match(xs)\\
Cons(a, Cons(b, xs1)) -\textgreater{} if(a \textgreater{} b)\\
then\\
val (sublist, bs) = descending(b, STuple(b, a), xs1) Sublist(sublist,
sequences(bs))\\
else\\
val (sublist, bs) = ascending(b, STuple(b, a), xs1) Sublist(sublist,
sequences(bs))\\
Cons(a, Nil) -\textgreater{} Singleton(a, End)\\
Nil -\textgreater{} End

fip fun descending(a : elem, sublist :
sublist\textless elem\textgreater, bs : list\textless elem\textgreater)
: (sublist\textless elem\textgreater, list\textless elem\textgreater)
match(bs)\\
Cons(b, bs1) \textbar{} a \textgreater{} b -\textgreater{} descending(b,
SCons(b, sublist), bs1)\\
bs -\textgreater{} (sublist, bs)
\end{quote}

33

FP2: Fully in-Place Functional Programming

\begin{quote}
fip fun ascending(a : elem, sublist : sublist\textless elem\textgreater,
bs : list\textless elem\textgreater) :
(sublist\textless elem\textgreater, list\textless elem\textgreater)
match(bs)\\
Cons(b, bs1) \textbar{} (a \textless= b) -\textgreater{} ascending(b,
SCons(b, sublist), bs1)\\
bs -\textgreater{} (reverse-sublist(sublist), bs)

fip fun to-list(c : sublist\textless a\textgreater, u : unit2) :
list\textless a\textgreater{}\\
match c\\
SCons(a, cs) -\textgreater{} Cons(a, to-list(cs, u))\\
STuple(a, b) -\textgreater{} Cons(a, Cons(b, Nil))

fip fun merge-all(xs : partition\textless elem\textgreater) :
\textless div\textgreater{} list\textless elem\textgreater{} match(xs)\\
Sublist(x, End) -\textgreater{} to-list(x, Unit2(Pad,Pad))\\
Singleton(x, End) -\textgreater{} Cons(x, Nil)\\
xs -\textgreater{} merge-all(merge-pairs(xs))

fip fun merge-pairs(xs : partition\textless elem\textgreater) :
\textless div\textgreater{} partition\textless elem\textgreater{}\\
match(xs)\\
Sublist(a, Sublist(b, xs1)) -\textgreater{} Sublist(merge(a, b,
Unit2(Pad,Pad)), merge-pairs(xs1))\\
Sublist(a, Singleton(b, xs1)) -\textgreater{} Sublist(merge-last-left(a,
b, Unit2(Pad,Pad)), merge-pairs(xs1)) Singleton(a, Sublist(b, xs1))
-\textgreater{} Sublist(merge-last-right(a, b, Unit2(Pad,Pad)),
merge-pairs(xs1)) Singleton(a, Singleton(b, xs1)) -\textgreater{}\\
Sublist(if a \textless= b then STuple(a, b) else STuple(b, a),
merge-pairs(xs1))\\
xs -\textgreater{} xs

fip fun merge(c1 : sublist\textless elem\textgreater, c2 :
sublist\textless elem\textgreater, u : unit2) :
\textless div\textgreater{} sublist\textless elem\textgreater{} match
c1\\
SCons(a, cs1) -\textgreater{} match c2\\
SCons(b, cs2) -\textgreater{}\\
if a \textless= b then SCons(a, merge(cs1, SCons(b, cs2), u))\\
else SCons(b, merge(SCons(a, cs1), cs2, u))\\
STuple(b, c) -\textgreater{}\\
if a \textless= b then SCons(a, merge(cs1, STuple(b, c), u))\\
else SCons(b, merge-last-left(SCons(a, cs1), c, u))\\
STuple(a, b) -\textgreater{} match c2\\
SCons(c, cs2) -\textgreater{}\\
if a \textless= c then SCons(a, merge-last-right(b, SCons(c, cs2), u))\\
else SCons(c, merge(STuple(a, b), cs2, u))\\
STuple(c, d) -\textgreater{}\\
if a \textless= c then SCons(a, merge-right(b, Pair(c, d), u))\\
else SCons(c, merge-left(Pair(a, b), d, u))

fip fun merge-last-right(a : elem, c2 :
sublist\textless elem\textgreater, u : unit2) :
sublist\textless elem\textgreater{} match c2\\
SCons(b, cs2) -\textgreater{} if a \textless= b\\
then SCons(a, SCons(b, cs2))\\
else SCons(b, merge-last-right(a, cs2, u))\\
STuple(b, c) -\textgreater{} merge-right(a, Pair(b, c), u)

fip fun merge-last-left(c2 : sublist\textless elem\textgreater, d :
elem, u : unit2) : sublist\textless elem\textgreater{} match c2\\
SCons(a, cs2) -\textgreater{} if a \textless= d\\
then SCons(a, merge-last-left(cs2, d, u))\\
else SCons(d, SCons(a, cs2))\\
STuple(a, b) -\textgreater{} merge-left(Pair(a, b), d, u)

fip fun merge-right(a : elem, p : pair\textless elem\textgreater, u :
unit2) : sublist\textless elem\textgreater{} match p\\
Pair(b, c) -\textgreater{} if a \textless= b\\
then SCons(a, STuple(b, c))\\
else SCons(b, if a \textless= c then STuple(a, c) else STuple(c, a))

fip fun merge-left(p : pair\textless elem\textgreater, d : elem, u :
unit2) : sublist\textless elem\textgreater{} match p\\
Pair(a, b) -\textgreater{} if a \textless= d\\
then SCons(a, if b \textless= d then STuple(b, d) else STuple(d, b))
else SCons(d, STuple(a, b))
\end{quote}

34

Anton Lorenzen, Daan Leijen, and Wouter Swierstra

\textbf{A.3} \textbf{Quick Sort}

\begin{quote}
import std/num/int32\\
import std/os/env

alias elem = int32

ref type pad\\
Pad

ref type unit2\\
Unit2(a : pad, b : pad)

type maybe2\textless a\textgreater{}\\
Nothing2\\
Just2(a : a, b : pad)

type sublist\textless a\textgreater{}\\
SCons(a : a, cs : sublist\textless a\textgreater)\\
STuple(a : a, b : a)

type partition\textless a\textgreater{}\\
Sublist(c : sublist\textless a\textgreater, bdl :
partition\textless a\textgreater)\\
Singleton(c : a, bdl : partition\textless a\textgreater)\\
End

fip fun from-list(x, y, u : unit2, xs : list\textless elem\textgreater)
: sublist\textless elem\textgreater{} match xs\\
Cons(z, zs) -\textgreater{} SCons(x, from-list(y, z, u, zs))\\
Nil -\textgreater{} STuple(x, y)

fip fun to-bundle(xs : list\textless elem\textgreater, bdl' :
partition\textless elem\textgreater) :
partition\textless elem\textgreater{} match xs\\
Cons(x, Cons(y, xs)) -\textgreater{} Sublist(from-list(x, y, Unit2(Pad,
Pad), xs), bdl') Cons(x, Nil) -\textgreater{} Singleton(x, bdl')\\
Nil -\textgreater{} bdl'

fip fun quicksort(xs : list\textless elem\textgreater) : div
list\textless elem\textgreater{} quicksort-go(to-bundle(xs, End))

fip fun quicksort-go(bdl : partition\textless elem\textgreater) : div
list\textless elem\textgreater{}\\
match bdl\\
Sublist(xs, bdl') -\textgreater{} match xs\\
SCons(p, xs) -\textgreater{}\\
val (lo, hi) = partition(p, xs, Unit2(Pad, Pad))\\
quicksort-go(to-bundle(lo, Singleton(p, to-bundle(hi, bdl')))) STuple(x,
y) \textbar{} x \textless= y -\textgreater{} Cons(x, Cons(y,
quicksort-go(bdl'))) \textbar{} \_\\
-\textgreater{} Cons(y, Cons(x, quicksort-go(bdl'))) Singleton(p, b)
-\textgreater{} Cons(p, quicksort-go(b))\\
End -\textgreater{} Nil

fip fun partition(\^{}p : elem, xs : sublist\textless elem\textgreater,
u : unit2) : (list\textless elem\textgreater,
list\textless elem\textgreater) match(xs)\\
SCons(x, xx) -\textgreater{} if p \textless= x\\
then val (lo, hi) = partition(p, xx, u)\\
(lo, Cons(x, hi))\\
else val (lo, hi) = partition(p, xx, u)\\
(Cons(x, lo), hi)\\
STuple(x, y) -\textgreater{} if p \textless= x\\
then if p \textless= y\\
then (Nil, Cons(x, Cons(y, Nil)))\\
else (Cons(y, Nil), Cons(x, Nil))\\
else if p \textless= y\\
then (Cons(x, Nil), Cons(y, Nil))\\
else (Cons(x, Cons(y, Nil)), Nil)
\end{quote}

