\begin{quote}
\textbf{Lemma 54.} (\emph{Hom isomorphism})

If \emph{H}2 →\emph{H}3, then \emph{H}1 ⊗\emph{H}2 →\emph{H}3 iff
\emph{H}1 →{[}\emph{H}2\emph{, H}3{]}.

\textbf{Proof}.
\end{quote}

\textbf{Case} Domain: We have dom({[}\emph{H}2\emph{, H}3{]})
⊆dom(\emph{H}3). If dom(\emph{H}1) ⊆dom({[}\emph{H}2\emph{, H}3{]}) and
dom(\emph{H}2) ⊆dom(\emph{H}3),

\begin{quote}
then dom(\emph{H}1)\emph{,} dom(\emph{H}2) ⊆dom(\emph{H}3).

If \emph{H}1 ⊗\emph{H}2 →\emph{H}3, then not only dom(\emph{H}1)\emph{,}
dom(\emph{H}2) ⊆dom(\emph{H}3), but in particular any \emph{x}
∈dom(\emph{H}3) will only be deleted in the first phase if not in
dom(\emph{H}1): Deletion requires that \emph{x} and all its parents have
the same reference count in \emph{H}2 and \emph{H}3, and that \emph{x}
or one of its parents is a root in \emph{H}3. But

then \emph{x} or one of its parents will also be a root in \emph{H}1, so
the reference count would have to be higher

in \emph{H}3 than in \emph{H}2. Thus dom(\emph{H}1)
⊆dom({[}\emph{H}2\emph{, H}3{]}).

\textbf{Case} Roots: Let Γ1\emph{,} Γ2\emph{,} Γ3 be the roots of
\emph{H}1\emph{, H}2\emph{, H}3 respectively. Clearly, Γ1\emph{,} Γ2 ⊆Γ3
iff Γ1 ⊆Γ3 −Γ2. By lemma 49 the first term gives the roots of \emph{H}1
⊗\emph{H}2 and by lemma 53 the second term gives the roots of
{[}\emph{H}2\emph{, H}3{]}.

\textbf{Lemma 55.} (\emph{Monotocity of subtracting heaps})

If \emph{H}3 →\emph{H}1 →\emph{H}2 →\emph{H}4 then {[}\emph{H}1\emph{,
H}2{]} →{[}\emph{H}3\emph{, H}4{]}.

\textbf{Proof}.

\textbf{Case} Domain: The domain of {[}\emph{H}3\emph{, H}4{]} consists
of all variables in \emph{H}4 which are not deleted. Any

such variable will be a root of or reachable from a root in \emph{H}3.
Since \emph{H}3 →\emph{H}1, the reference counts of \emph{H}1 are at
least as big as those in \emph{H}3. Thus any deletion in the
construction of {[}\emph{H}3\emph{, H}4{]} will also

happen during the construction of {[}\emph{H}1\emph{, H}2{]}.

\textbf{Case} Roots:

roots({[}\emph{H}1\emph{, H}2{]})\emph{,} roots(\emph{H}1) =
roots(\emph{H}2)

roots(\emph{H}3) ⊆roots(\emph{H}1)

roots({[}\emph{H}1\emph{, H}2{]}) ⊆roots({[}\emph{H}3\emph{, H}4{]})\\
⊆roots(\emph{H}4) = roots({[}\emph{H}3\emph{, H}4{]})\emph{,}
roots(\emph{H}3)\\
(1), by lemma 53
\end{quote}

(2), by lemma 53

(3), by assumption

(4), by (2) and (3)

\begin{quote}
Notice that this does not quite give us a closed monoidal category,
since the internal hom {[}\emph{H}1\emph{, H}2{]}

is only defined if \emph{H}1 →\emph{H}2. Nonetheless, many results about
closed monoidal categories also hold in
\end{quote}

