\begin{quote}
\textbf{Lemma 12.} (\emph{The delta environment can be weakened}) If Δ
\textbar{} Γ ⊢\emph{e}, then Δ\emph{, x} \textbar{} Γ ⊢\emph{e} for any
\emph{x} ̸∈Γ.

\textbf{Proof}. By straight-forward induction on the judgement Δ
\textbar{} Γ ⊢\emph{e}. We have to require \emph{x} ̸∈Γ as we have to
ensure Δ\emph{, x} ∩Γ = ∅.
\end{quote}

The next lemma is the main lemma of our soundness proof. It says that
the individual steps of the store semantics take sound/linear stores to
sound/linear stores. As usual, the judgement −→s does not include the
eval rule.

\begin{quote}
\textbf{Lemma 13.} (\emph{Store semantics preserves linearity and roots
(no eval ctx)}) If \emph{I} (\emph{e,} Δ\emph{,} Γ\emph{, S}1\emph{,
S}2) and \emph{S}1\emph{, S}2 \textbar{} \emph{e} −→s \emph{S}1\emph{,
S}3 \textbar{} \emph{e}′, then \emph{I} (\emph{e}′\emph{,} Δ′\emph{,}
Γ′\emph{, S}1\emph{, S}3). \textbf{Proof}. By case analysis on the rules
of the store semantics.

\textbf{Case} (\emph{lets}). \emph{S}3 := \emph{S}2 define

Δ\uline{\textbar{}} Γ\emph{,y} ⊢let\emph{x} =\emph{y} in \emph{e}

Δ \textbar{} Γ\emph{,x} ⊢\emph{e}Δ \textbar{} Γ\emph{,y}
⊢\emph{e}{[}\emph{x}:=\emph{y}{]}Γ\emph{, y} = roots(\emph{S}2) =
roots(\emph{S}3) given given by let by lemma 11

\textbf{Case} (\emph{calls}).
\end{quote}

