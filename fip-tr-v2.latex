\begin{quote}
(\emph{bmatchh}) (\emph{dmatchh}) H\emph{, y} ↦→\emph{nCky} \textbar{}
match \emph{y} \{\emph{p} \uline{→}\emph{e}\} H\emph{, x} ↦→1\emph{Cky}
