\begin{quote}
\textbf{Case} Let \emph{x} ∈Γ1. As \emph{x} is a root of S, it does not
occur in fv(rng(S)). As such, if \emph{x} ∈dom(S{[}Γ2{]}) or \emph{x}
∈dom(S\emph{cyc}), it would be a root of S{[}Γ2{]} or S\emph{cyc}
respectively. But \emph{x} ̸∈Γ2 by assumption and \emph{x} ̸∈∅. Thus the
claim holds for all roots Γ1.

\textbf{Case} Let \emph{x} ∈fv(\emph{v}) with \emph{y} ↦→\emph{v}
∈S{[}Γ1{]}, \emph{y} ̸∈dom(S{[}Γ2{]}) and \emph{y} ̸∈dom(S\emph{cyc}).
Since S is linear and \emph{x} ∈fv(\emph{v}), \emph{x}
̸∈fv(rng(S{[}Γ2{]})) and \emph{x} ̸∈fv(rng(S\emph{cyc})). Then \emph{x}
might still be a root of S{[}Γ2{]} or S\emph{cyc}. But \emph{x} ̸∈Γ2
since \emph{x} is not a root of S and \emph{x} ̸∈∅.

Now we show that they cover S. Let S′= S −(S{[}Γ1{]}\emph{,}
S{[}Γ2{]}\emph{,} S\emph{cyc}). Then S′is a linear store with roots(S′)
= ∅:

\textbf{Case} S′is sound: Assume that \emph{x} ∈fv(rng(S′)) but \emph{x}
̸∈dom(S′). Since S is linear, \emph{x} must be a root of
S{[}Γ1{]}\emph{,} S{[}Γ2{]}\emph{,} S\emph{cyc}. But by lemma 3 (see
below), the roots of S{[}Γ1{]}\emph{,} S{[}Γ2{]}\emph{,} S\emph{cyc} are
Γ1\emph{,} Γ2 which are also the roots of S. This is a contradiction,
since \emph{x} is not a root of S.

\textbf{Case} S′is linear: Clearly, since S′is a subset of S which is
linear.
\end{quote}

\textbf{Case} Assume that \emph{x} ∈roots(S′). Since Γ1\emph{,} Γ2
∈dom(S{[}Γ1{]}\emph{,} S{[}Γ2{]}\emph{,} S\emph{cyc}), \emph{x} is not a
root of S. But since S is linear, this implies that S{[}Γ1{]}\emph{,}
S{[}Γ2{]}\emph{,} S\emph{cyc} is not sound, which is a contradiction to
lemma 3.

\begin{quote}
But then (by lemma 3, see below) we could add S′to S\emph{cyc} to obtain
a linear subset of S with no

roots. Since S\emph{cyc} is already the largest such subset, S′= ∅.
\end{quote}

We call this property \emph{cycle-free}. Formally, a store S is cycle
free if for any property \emph{P} with The above lemma makes use of the
fact that S{[}Γ{]} contains just values reachable from the roots Γ.

\begin{quote}
• \emph{P}(\emph{x}) for all \emph{x} ∈Γ\\
• \emph{P}(\emph{x}) for all \emph{x} ∈fv(\emph{v}) with \emph{y}
↦→\emph{v} ∈S and \emph{P}(\emph{y})\\
we have \emph{P}(\emph{x}) for all \emph{x} ∈dom(S). In particular, the
induced store is cycle-free:

\textbf{Lemma 2.} (\emph{Reachability from roots})

Let S be a linear store, Γ ⊆roots(S) and S{[}Γ{]} the smallest linear
subset of S containing Γ. Then S{[}Γ{]} is cycle-free.

\textbf{Proof}. Let S′be the subset of S{[}Γ{]} for which \emph{P} is
not true. We claim that S{[}Γ{]} −S′is still a linear subset of S
containing Γ. Since S{[}Γ{]} being the smallest such set, this implies
S′= ∅.

\textbf{Case} Soundness of S{[}Γ{]} −S′: Assume that there is \emph{x}
∈fv(rng(S{[}Γ{]} −S′)) with \emph{x} ̸∈dom(S{[}Γ{]} −S′). Choose
\emph{y} ↦→\emph{v} ∈(S{[}Γ{]} −S′) with \emph{x} ∈fv(\emph{v}). Since
\emph{y} ∈dom(S{[}Γ{]} −S′), we have \emph{P}(\emph{y}). But since
S{[}Γ{]} is sound, \emph{x} ∈dom(S{[}Γ{]}) and thus \emph{x} ∈dom(S′).
If \emph{x} ∈dom(S′), \emph{P}(\emph{x}) is not true, which is a
contradiction to the second rule of \emph{P}.

\textbf{Case} Linearity of S{[}Γ{]} −S′: Since S{[}Γ{]} is linear, so is
any subset of S{[}Γ{]}.

\textbf{Case} S{[}Γ{]} −S′contains Γ: By assumption \emph{P}(\emph{x})
is true for all \emph{x} ∈Γ, so Γ ∩S′= ∅.

We can combine any linear stores again to obtain a linear store:

\textbf{Lemma 3.} (\emph{Store joining})

Let \emph{S}1 and \emph{S}2 be disjoint sound/linear stores with roots
Γ1 and Γ2. Then \emph{S}1\emph{, S}2 is a sound/linear store

with roots Γ1\emph{,} Γ2.

\textbf{Proof}.

\textbf{Case} Soundness: Let \emph{x} ∈fv(rng(\emph{S}1\emph{, S}2)).
Then either \emph{x} ∈fv(rng(\emph{S}1)) or \emph{x} ∈fv(rng(\emph{S}2))
and by the soundness of \emph{S}1 and \emph{S}2, we have \emph{x}
∈dom(\emph{S}1) or \emph{x} ∈dom(\emph{S}2).

\textbf{Case} Linearity: Let \emph{x} ∈dom(\emph{S}1\emph{, S}2). Since
\emph{S}1 and \emph{S}2 are disjoint, either \emph{x} ∈dom(\emph{S}1)
(exclusive) or \emph{x} ∈dom(\emph{S}2). Without loss of generality,
assume \emph{x} ∈dom(\emph{S}1). Then \emph{x} ̸∈dom(\emph{S}2) and by
soundness of \emph{S}2, \emph{x} ̸∈fv(rng(\emph{S}2)). By linearity of
\emph{S}1, \emph{x} occurs at most once in the free variables of
\end{quote}

