FP2: Fully in-Place Functional Programming

our setting. As an example of the usefulness of the categorical
perspective, we show that subtracting two heaps one-by-one yields the
same result as subtracting them as one joined heap:

\textbf{Lemma 56.} (\emph{Internalized hom isomorphism})\\
If \emph{H}2 →\emph{H}3 and \emph{H}1 →{[}\emph{H}2\emph{, H}3{]}, then
{[}\emph{H}1 ⊗\emph{H}2\emph{, H}3{]} = {[}\emph{H}1\emph{,}
{[}\emph{H}2\emph{, H}3{]}{]}.

\textbf{Proof}. Let H be a heap with H →{[}\emph{H}1 ⊗\emph{H}2\emph{,
H}3{]}. Then: H →{[}\emph{H}1 ⊗\emph{H}2\emph{, H}3{]} iff (H
⊗(\emph{H}1 ⊗\emph{H}2)) →\emph{H}3 iff ((H ⊗\emph{H}1) ⊗\emph{H}2)
→\emph{H}3 iff (H ⊗\emph{H}1) →{[}\emph{H}2\emph{, H}3{]} iff H
→{[}\emph{H}1\emph{,} {[}\emph{H}2\emph{, H}3{]}{]} (1), by assumption
(2), by lemma 54 (3), by lemma 50 (4), by lemma 54 (5), by lemma 54

By instantiating H to {[}\emph{H}1 ⊗\emph{H}2\emph{, H}3{]} and
{[}\emph{H}1\emph{,} {[}\emph{H}2\emph{, H}3{]}{]} using reflexivity, we
obtain the equality. And we can show the existence of the universal
morphisms:

\textbf{Lemma 57.} (\emph{Existence of counit})\\
If \emph{H}1 →\emph{H}2 then {[}\emph{H}1\emph{, H}2{]} ⊗\emph{H}1 =
\emph{H}2.

which is true by reflexivity. \textbf{Proof}. {[}\emph{H}1\emph{, H}2{]}
⊗\emph{H}1 →\emph{H}2: By lemma 54, we have {[}\emph{H}1\emph{, H}2{]}
⊗\emph{H}1 →\emph{H}2 iff {[}\emph{H}1\emph{, H}2{]}
→{[}\emph{H}1\emph{, H}2{]},

\emph{H}2 →{[}\emph{H}1\emph{, H}2{]} ⊗\emph{H}1: We have dom(\emph{H}2)
⊆(dom(\emph{H}2) −dom(\emph{H}1))\emph{,} dom(\emph{H}1)
⊆dom({[}\emph{H}1\emph{, H}2{]})\emph{,} dom(\emph{H}1). Additionally,
roots(\emph{H}2) = (roots(\emph{H}2) −roots(\emph{H}1))\emph{,}
roots(\emph{H}1).

\textbf{Lemma 58.} (\emph{Existence of unit})\\
For any heaps \emph{H}1\emph{, H}2 we have \emph{H}1
→{[}\emph{H}2\emph{, H}1 ⊗\emph{H}2{]}.\\
\textbf{Proof}. By lemma 54, we have \emph{H}1 →{[}\emph{H}2\emph{, H}1
⊗\emph{H}2{]} iff \emph{H}1 ⊗\emph{H}2 →\emph{H}1 ⊗\emph{H}2, which is
true by reflex-ivity.

Notice that the above inequality is strict since {[}\emph{H}2\emph{, H}1
⊗\emph{H}2{]} contains all cycles from \emph{H}2. However, the cycles do
not matter too much, since they will also be present in all other heaps
which \emph{H}2 was subtracted from:

\textbf{Lemma 59.} (\emph{Universal morphism for unit})\\
If \emph{H}2 →\emph{H}3 and \emph{H}1 →{[}\emph{H}2\emph{, H}3{]} then
{[}\emph{H}2\emph{, H}1 ⊗\emph{H}2{]} →{[}\emph{H}2\emph{, H}3{]}.

\textbf{Proof}. We have \emph{H}1 ⊗\emph{H}2 →\emph{H}3 by lemma 54,
which implies the claim by lemma 55.

Our last lemma says that if it is possible to subtract \emph{H}1 from
\emph{H}2, we can add any \emph{H}3 equally before or after the
subtraction.

\textbf{Lemma 60.} (\emph{Joining distributes over subtraction})\\
If \emph{H}1 →\emph{H}2 then {[}\emph{H}1\emph{, H}2 ⊗\emph{H}3{]} =
{[}\emph{H}1\emph{, H}2{]} ⊗\emph{H}3.\\
\textbf{Proof}.
\end{quote}

\textbf{Case} Domain: Since \emph{H}1 →\emph{H}2, an \emph{x}
∈dom(\emph{H}3) can not get deleted in the construction of
{[}\emph{H}1\emph{, H}2 ⊗\emph{H}3{]}. Thus dom({[}\emph{H}1\emph{, H}2
⊗\emph{H}3{]}) = dom({[}\emph{H}1\emph{, H}2{]})\emph{,} dom(\emph{H}3).

\begin{quote}
\textbf{Case} Roots:

roots({[}\emph{H}1\emph{, H}2 ⊗\emph{H}3{]}) = (roots(\emph{H}2)\emph{,}
roots(\emph{H}3) −roots(\emph{H}1)) = (roots(\emph{H}2)
−roots(\emph{H}1))\emph{,} roots(\emph{H}3) = roots({[}\emph{H}1\emph{,
H}2{]} ⊗\emph{H}3) (1) (2) (3) (4)
\end{quote}

